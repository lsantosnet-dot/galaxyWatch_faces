<?xml version="1.0" encoding="utf-8"?>
<!--
  Watch Face Format (WFF). O relógio lê este arquivo e desenha tudo sozinho:
  não existe código rodando no relógio para o mostrador.
  Coordenadas em pixels de uma tela 450x450 (origem no canto superior esquerdo).
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:34" />


    <Scene backgroundColor="#ff000000">

        <!-- 1) Mostrador: números, marcações e fundo (imagem gerada pelo script Python) -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="dial" />
        </PartImage>

        <!-- 2) Ícone de bateria + percentual (embaixo) -->
        <PartImage x="215" y="296" width="20" height="28">
            <Image resource="icon_bolt" />
        </PartImage>
        <PartText x="145" y="330" width="160" height="34">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="24" color="#ff343438">
                    <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 3) Dia da semana por extenso (esquerda), ex.: "terça-feira" -->
        <PartText x="50" y="244" width="150" height="34">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" color="#ff343438">
                    <Template>%s<Parameter expression="[DAY_OF_WEEK_F]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 4) Relógio digital com segundos (direita). Some no modo ambiente. -->
        <DigitalClock x="250" y="176" width="150" height="34">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <TimeText x="0" y="0" width="150" height="34" format="hh:mm:ss" align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" color="#ff343438" />
            </TimeText>
        </DigitalClock>

        <!-- 5) Complicação: nascer/pôr do sol (em cima). O usuário pode trocar. -->
        <ComplicationSlot slotId="0" name="SUN" displayName="@string/slot_sun"
                          supportedTypes="SHORT_TEXT"
                          x="150" y="90" width="150" height="80">
            <DefaultProviderPolicy defaultSystemProvider="SUNRISE_SUNSET"
                                   defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="150" height="80" />
            <Complication type="SHORT_TEXT">
                <PartImage x="61" y="0" width="28" height="28">
                    <Image resource="icon_sun" />
                </PartImage>
                <PartText x="0" y="32" width="150" height="34">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="22" color="#ff343438">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 6) Ponteiros. Cada imagem aponta para cima e gira em volta do pivô
                (pivotY = onde fica o centro do relógio dentro da imagem, de 0 a 1). -->
        <AnalogClock x="0" y="0" width="450" height="450">
            <!-- hora: imagem 24x134, pivô a 112px do topo -->
            <HourHand resource="hour_hand" x="213" y="113" width="24" height="134"
                      pivotX="0.5" pivotY="0.8358" />
            <!-- minuto: imagem 20x208, pivô a 182px do topo -->
            <MinuteHand resource="minute_hand" x="215" y="43" width="20" height="208"
                        pivotX="0.5" pivotY="0.875" />
            <!-- segundos: imagem 20x275, pivô a 205px do topo; vermelho; some no ambiente -->
            <SecondHand resource="second_hand" x="215" y="20" width="20" height="275"
                        pivotX="0.5" pivotY="0.7454">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </SecondHand>
        </AnalogClock>

        <!-- 7) Capa central preta (esconde o encontro dos ponteiros da hora/minuto) -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="216" y="216" width="18" height="18">
                <Fill color="#ff121214" />
            </Ellipse>
        </PartDraw>
    </Scene>
</WatchFace>
