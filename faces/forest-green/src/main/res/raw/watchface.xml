<?xml version="1.0" encoding="utf-8"?>
<!--
  Forest Green — Watch Face Format v2. Tela lógica 450x450 (origem no canto superior esquerdo).

  Camadas: folhagem (background) → arco da meta diária → marcações e números (dial)
           → dados (clima, bateria, passos, meta) → ponteiros.
  As imagens e o preview.png saem de art/generate_images.py, que usa as MESMAS posições daqui.

  Texto: cada PartText tem altura = 1.2 x tamanho da fonte e o texto fica centrado
  verticalmente na caixa (centro da caixa = centro das letras no preview).

  Cor de destaque (arco, ícones, %): Personalizar > Cor. Use [CONFIGURATION.accent.0].
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:36" />

    <UserConfigurations>
        <ColorConfiguration id="accent" displayName="@string/cfg_accent" defaultValue="lime">
            <ColorOption id="lime" displayName="@string/color_lime" colors="#ff8be04a" />
            <ColorOption id="mint" displayName="@string/color_mint" colors="#ff3ddc97" />
            <ColorOption id="yellow" displayName="@string/color_yellow" colors="#ffffd60a" />
            <ColorOption id="orange" displayName="@string/color_orange" colors="#ffff9f0a" />
            <ColorOption id="cyan" displayName="@string/color_cyan" colors="#ff40c8e0" />
            <ColorOption id="white" displayName="@string/color_white" colors="#ffffffff" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff081a10">

        <!-- 1) Folhagem. No modo ambiente (tela sempre ligada) some para economizar bateria. -->
        <PartImage x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Image resource="background" />
        </PartImage>

        <!-- 2) Arco da meta diária de passos: de 8h (240°) até 4h (120°), passando pelo 6.
                0° = 12h, sentido horário. O traço fica centrado no raio (373/2 = 186.5). -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="150" />
            <!-- trilho -->
            <Arc centerX="225" centerY="225" width="373" height="373" startAngle="120" endAngle="240">
                <Stroke color="#32ffffff" thickness="11" cap="ROUND" />
            </Arc>
            <!-- progresso: cresce a partir das 8h conforme [STEP_PERCENT] (0..100) -->
            <Arc centerX="225" centerY="225" width="373" height="373" startAngle="240" endAngle="240">
                <Transform target="startAngle" value="240 - 1.2 * clamp([STEP_PERCENT], 0, 100)" />
                <Stroke color="[CONFIGURATION.accent.0]" thickness="11" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- 3) Marcações + números 12/3/6/9 (fonte Russo One, desenhados na imagem) -->
        <PartImage x="0" y="0" width="450" height="450">
            <Image resource="dial" />
        </PartImage>

        <!-- 4) Clima (complicação editável). Padrão: Samsung Weather.
                Linha 1: ícone + temperatura. Linha 2: condição/local (título). -->
        <ComplicationSlot slotId="0" name="WEATHER" displayName="@string/slot_weather"
                          supportedTypes="SHORT_TEXT"
                          x="104" y="176" width="120" height="60">
            <DefaultProviderPolicy
                primaryProvider="com.samsung.android.watch.weather/com.samsung.android.watch.weather.complication.WeatherComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="120" height="60" />
            <Complication type="SHORT_TEXT">
                <PartImage x="0" y="2" width="26" height="26">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="32" y="0" width="88" height="31">
                    <Text align="START">
                        <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="34" width="120" height="21">
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="17" weight="SEMI_BOLD" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- 5) Bateria: contorno + nível (retângulo que cresce com o %) -->
        <PartImage x="301" y="178" width="34" height="18" tintColor="[CONFIGURATION.accent.0]">
            <Image resource="icon_battery" />
        </PartImage>
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="305" y="182" width="22" height="10">
                <Transform target="width" value="0.22 * clamp([BATTERY_PERCENT], 0, 100)" />
                <Fill color="[CONFIGURATION.accent.0]" />
            </Rectangle>
        </PartDraw>
        <PartText x="258" y="202" width="120" height="31">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
                    <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="258" y="234" width="120" height="21">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="SEMI_BOLD" color="#ffffffff">Bateria</Font>
            </Text>
        </PartText>

        <!-- 6) Passos -->
        <PartImage x="128" y="262" width="24" height="28" tintColor="[CONFIGURATION.accent.0]">
            <Image resource="icon_walk" />
        </PartImage>
        <PartText x="70" y="294" width="140" height="31">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="#ffffffff">
                    <Template>%d<Parameter expression="[STEP_COUNT]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="70" y="326" width="140" height="21">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="17" weight="SEMI_BOLD" color="#ffffffff">Passos</Font>
            </Text>
        </PartText>

        <!-- 7) Meta diária (% da meta de passos — a mesma do arco) -->
        <PartText x="198" y="265" width="140" height="31">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="SEMI_BOLD" color="[CONFIGURATION.accent.0]">
                    <Template>%d%%<Parameter expression="[STEP_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="198" y="298" width="140" height="18">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="15" weight="SEMI_BOLD" color="#ffffffff">META DIÁRIA</Font>
            </Text>
        </PartText>

        <!-- 8) Ponteiros brancos finos. Cada imagem aponta para cima e gira no pivô
                (pivotY = posição do centro do relógio dentro da imagem, de 0 a 1). -->
        <AnalogClock x="0" y="0" width="450" height="450">
            <!-- hora: 12x134, pivô a 118 px do topo -->
            <HourHand resource="hour_hand" x="219" y="107" width="12" height="134"
                      pivotX="0.5" pivotY="0.8806" />
            <!-- minuto: 12x206, pivô a 188 px do topo -->
            <MinuteHand resource="minute_hand" x="219" y="37" width="12" height="206"
                        pivotX="0.5" pivotY="0.9126" />
            <!-- segundos: 12x239, pivô a 205 px do topo; some no modo ambiente -->
            <SecondHand resource="second_hand" x="219" y="20" width="12" height="239"
                        pivotX="0.5" pivotY="0.8577">
                <Variant mode="AMBIENT" target="alpha" value="0" />
            </SecondHand>
        </AnalogClock>

        <!-- 9) Capa central -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Ellipse x="219" y="219" width="12" height="12">
                <Fill color="#ffffffff" />
            </Ellipse>
            <Ellipse x="222" y="222" width="6" height="6">
                <Fill color="#ff143220" />
            </Ellipse>
        </PartDraw>
    </Scene>
</WatchFace>
