<?xml version="1.0" encoding="utf-8"?>
<!--
  Orange Digital — Watch Face Format v2.
  Tela lógica 450x450 (origem no canto superior esquerdo).
  Fonte: Bebas Neue (res/font/bebas_neue.ttf). É só maiúsculas: "terça-feira" aparece "TERÇA-FEIRA".

  Posicionamento do texto: a caixa de cada PartText tem altura = 1.2 x tamanho da fonte
  e y = topo_das_letras - 0.18 x tamanho. Assim o topo das letras cai exatamente onde queremos.
  Os cantos de cada bloco foram conferidos para ficar dentro do círculo (raio 225).

  Cor de destaque: escolhida pelo usuário (Personalizar > Cor). Use [CONFIGURATION.accent.0].
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="16:02:00" />

    <UserConfigurations>
        <ColorConfiguration id="accent" displayName="@string/cfg_accent" defaultValue="orange">
            <ColorOption id="orange" displayName="@string/color_orange" colors="#ffff8c1a" />
            <ColorOption id="red" displayName="@string/color_red" colors="#ffff3b30" />
            <ColorOption id="yellow" displayName="@string/color_yellow" colors="#ffffd60a" />
            <ColorOption id="green" displayName="@string/color_green" colors="#ff30d158" />
            <ColorOption id="cyan" displayName="@string/color_cyan" colors="#ff40c8e0" />
            <ColorOption id="blue" displayName="@string/color_blue" colors="#ff0a84ff" />
            <ColorOption id="pink" displayName="@string/color_pink" colors="#ffff375f" />
            <ColorOption id="white" displayName="@string/color_white" colors="#ffffffff" />
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#ff000000">

        <!-- ============================ topo: data ============================ -->

        <!-- "AGOSTO 22" (mês por extenso + dia) -->
        <PartText x="96" y="40" width="240" height="41">
            <Text align="START">
                <Font family="bebas_neue" size="34" color="#ffffffff">
                    <Template>%s %d<Parameter expression="[MONTH_F]" /><Parameter expression="[DAY]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- "TERÇA-FEIRA" (dia da semana por extenso, cor de destaque) -->
        <PartText x="88" y="70" width="240" height="65">
            <Text align="START">
                <Font family="bebas_neue" size="54" color="[CONFIGURATION.accent.0]">
                    <Template>%s<Parameter expression="[DAY_OF_WEEK_F]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ===================== clima (na linha da data) ===================== -->
        <!-- Complicação editável. Padrão: Samsung Weather (ícone + temperatura).
             Se o app não existir no relógio, o slot começa vazio e você escolhe outro. -->
        <ComplicationSlot slotId="2" name="TOP" displayName="@string/slot_top"
                          supportedTypes="SHORT_TEXT"
                          x="254" y="40" width="118" height="41">
            <DefaultProviderPolicy
                primaryProvider="com.samsung.android.watch.weather/com.samsung.android.watch.weather.complication.WeatherComplicationService"
                primaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="118" height="41" />
            <Complication type="SHORT_TEXT">
                <PartImage x="0" y="5" width="26" height="26">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="32" y="0" width="86" height="41">
                    <Text align="START">
                        <Font family="bebas_neue" size="34" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ============================ bateria ============================ -->
        <PartImage x="88" y="141" width="18" height="30" tintColor="[CONFIGURATION.accent.0]">
            <Image resource="icon_bolt" />
        </PartImage>
        <PartText x="110" y="132" width="84" height="55">
            <Text align="START">
                <Font family="bebas_neue" size="46" color="#ffffffff">
                    <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ============================ hora ============================ -->
        <!-- Horas (brancas, alinhadas à direita em x=208). 12h/24h segue o relógio. -->
        <DigitalClock x="8" y="149" width="200" height="258">
            <TimeText format="hh" hourFormat="SYNC_TO_DEVICE" align="END" x="0" y="0" width="200" height="258">
                <Font family="bebas_neue" size="215" color="#ffffffff" />
            </TimeText>
        </DigitalClock>

        <!-- Minutos (cor de destaque, maiores e mais altos que as horas) -->
        <DigitalClock x="230" y="89" width="216" height="286">
            <TimeText format="mm" align="START" x="0" y="0" width="216" height="286">
                <Font family="bebas_neue" size="238" color="[CONFIGURATION.accent.0]" />
            </TimeText>
        </DigitalClock>

        <!-- Divisórias finas + "dois-pontos" -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Rectangle x="198" y="141" width="3" height="32"><Fill color="#80ffffff" /></Rectangle>
            <Rectangle x="214" y="226" width="10" height="10"><Fill color="#ffffffff" /></Rectangle>
            <Rectangle x="214" y="272" width="10" height="10"><Fill color="#ffffffff" /></Rectangle>
            <Rectangle x="227" y="346" width="3" height="64"><Fill color="#80ffffff" /></Rectangle>
        </PartDraw>

        <!-- ======================= complicações (editáveis) =======================
             Layout de cada uma: ícone + título (cor de destaque) em cima, valor (branco) embaixo.
             Padrão: passos (esquerda) e batimentos (direita). Troque no relógio
             (toque e segure > Personalizar) ou no app Galaxy Wearable. -->

        <ComplicationSlot slotId="0" name="LEFT" displayName="@string/slot_left"
                          supportedTypes="SHORT_TEXT"
                          x="100" y="346" width="122" height="70">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT"
                                   defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="122" height="70" />
            <Complication type="SHORT_TEXT">
                <PartImage x="0" y="3" width="24" height="24">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="28" y="0" width="94" height="34">
                    <Text align="START">
                        <Font family="bebas_neue" size="28" color="[CONFIGURATION.accent.0]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="26" width="122" height="55">
                    <Text align="START">
                        <Font family="bebas_neue" size="46" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <ComplicationSlot slotId="1" name="RIGHT" displayName="@string/slot_right"
                          supportedTypes="SHORT_TEXT"
                          x="240" y="306" width="150" height="70">
            <DefaultProviderPolicy defaultSystemProvider="HEART_RATE"
                                   defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="150" height="70" />
            <Complication type="SHORT_TEXT">
                <PartImage x="0" y="3" width="24" height="24">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="28" y="0" width="122" height="34">
                    <Text align="START">
                        <Font family="bebas_neue" size="28" color="[CONFIGURATION.accent.0]">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="26" width="150" height="55">
                    <Text align="START">
                        <Font family="bebas_neue" size="46" color="#ffffffff">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
