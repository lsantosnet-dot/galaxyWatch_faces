<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Permissão do Watch Face Push (instalar/atualizar/ativar watch faces) -->
    <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />

    <application
        android:icon="@android:drawable/ic_menu_gallery"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recebe o APK do watch face enviado pelo celular (canal /watchface/apk) -->
        <service
            android:name=".InstallerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/watchface" />
            </intent-filter>
        </service>
    </application>
</manifest>
